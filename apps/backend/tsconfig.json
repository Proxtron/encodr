{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["src/**/*.test.ts"]
}