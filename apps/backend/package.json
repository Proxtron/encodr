  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proxtron/members-only.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:redis": "redis-server",
    "dev:sqs": "tsx --watch --env-file=.env src/sqs-consumer.ts",
    "dev:express": "tsx --watch --env-file=.env src/app.ts",
    "dev:worker": "tsx --watch --env-file=.env src/worker.ts",
    "dev": "concurrently \"npm run dev:redis\" \"npm run dev:worker\" \"npm run dev:sqs\" \"npm run dev:express\"",
    "build": "prisma generate && tsc",
    "clean": "rm -rf dist",
    "start": "node ./dist/app.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-sqs": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "@types/express": "^5.0.6",
    "bullmq": "^5.77.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sqs-consumer": "^15.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.142",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3"
  }
}
