  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:redis": "redis-server",
    "dev:sqs": "tsx --watch --env-file=.env src/sqs-consumer.ts",
    "dev:express": "tsx --watch --env-file=.env src/app.ts",
    "dev": "concurrently \"npm run dev:redis\" \"npm run dev:sqs\" \"npm run dev:express\"",
    "build": "prisma generate && tsc && copyfiles -u 1 \"src/views/**/*\" \"src/public/**/*\" dist/src",
    "clean": "rm -rf dist",
    "start": "node ./dist/src/app.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-sqs": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@quixo3/prisma-session-store": "^3.1.19",
    "@supabase/supabase-js": "^2.105.0",
    "@types/bcrypt": "^6.0.0",
    "@types/connect-flash": "^0.0.40",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.6",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sqs-consumer": "^15.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0"
  }
