generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VideoStatus {
  PENDING
  QUEUED
  PROCESSING
  READY
  FAILED
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Video {
  id          Int         @id @default(autoincrement())
  uploadName  String
  uuidName    String      @unique
  extension   String
  status VideoStatus @default(PENDING)
}