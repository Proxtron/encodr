generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Video {
  id         Int    @id @default(autoincrement())
  uploadName String
  uuidName   String @unique
  extension  String
}
